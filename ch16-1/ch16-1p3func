// 나중에 배열 포인터로도 해볼것
#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)

#include <stdio.h>

void inputMatrix(int m[][3]);
void getMax(int m[][3], int* max, int* row, int* col);
void printResult(int max, int row, int col);

int main(void)
{
	int m[3][3] = { 0 };
	// int m[3][3] = { {-5, 2, 35}, {-20, 5, 100}, {-75, 5, -25} };
	int max;
	int row, col;

	inputMatrix(&m[0][0]); 
	getMax(&m[0][0], &max, &row, &col);
	printResult(max, row, col);

	return 0;
}
// 3x3 행렬에 값을 넣는 함수
void inputMatrix(int m[][3])
{
	for (int i = 0; i < 3; i++)
	{
		for (int j = 0; j < 3; j++)
		{
			printf("%d행 %d열 원소 입력: ", i + 1, j + 1);
			scanf("%d", &m[i][j]); 
		}
	}
}
// 최댓값과 위치를 찾는 함수
void getMax(int m[][3], int* max, int* row, int* col) 
{
	*max = m[0][0];
	*row = 1, *col = 1;

	for (int i = 0; i < 3; i++)
	{
		for (int j = 0; j < 3; j++)
		{
			if (m[i][j] > *max) // *(m + j + 3 * i)
			{
				*max = m[i][j]; // *(m + j + 3 * i)
				*row = i + 1;
				*col = j + 1;
			}
		}
	}
}
// 결과를 출력하는 함수
void printResult(int max, int row, int col)
{
	printf("최댓값: %d\n", max);
	printf("위치: %d행 %d열\n", row, col);
}
